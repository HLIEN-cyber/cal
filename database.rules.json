{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "notices": {
      ".read": true,
      ".indexOn": [
        "date",
        "createdAt"
      ],
      "$id": {
        ".write": "auth != null && (root.child('members').child(auth.uid).child('role').val() === 'admin' || (root.child('members').child(auth.uid).child('role').val() === 'contributor' && (!data.exists() || data.child('authorUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['title','body','authorUid','createdAt']) && (data.exists() || newData.hasChild('date'))",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "authorUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() > 0 && newData.val() <= now))"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^(19[0-9]{2}|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
        },
        "grade": {
          ".validate": "newData.isString() && (newData.val() === 'all' || newData.val() === 'K' || newData.val().matches(/^[1-5]$/))"
        },
        "$other": {
          ".validate": false
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        }
      }
    },
    "events": {
      ".read": true,
      ".indexOn": [
        "date",
        "createdAt"
      ],
      "$id": {
        ".write": "auth != null && (root.child('members').child(auth.uid).child('role').val() === 'admin' || (root.child('members').child(auth.uid).child('role').val() === 'contributor' && (!data.exists() || data.child('authorUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['title','body','authorUid','createdAt','date']) && (data.exists() || newData.hasChild('date'))",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "authorUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() > 0 && newData.val() <= now))"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^(19[0-9]{2}|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
        },
        "grade": {
          ".validate": "newData.isString() && (newData.val() === 'all' || newData.val() === 'K' || newData.val().matches(/^[1-5]$/))"
        },
        "$other": {
          ".validate": false
        },
        "time": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
        },
        "place": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      }
    }
  }
}
